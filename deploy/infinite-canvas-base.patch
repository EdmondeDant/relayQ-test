index 0000000..4316349
--- /dev/null
+++ b/web/src/lib/relayq-integration.ts
@@ -0,0 +1,63 @@
+import { useEffect, useState } from "react";
+
+type RelayQBootstrap = {
+    api_key?: string;
+    user?: { balance?: number };
+    dashboard_url?: string;
+    usage_url?: string;
+    relayq_origin?: string;
+};
+
+function bootstrap(): RelayQBootstrap | null {
+    try {
+        const handoffPrefix = "relayq_canvas_bootstrap:";
+        if (window.name.startsWith(handoffPrefix)) {
+            window.sessionStorage.setItem("relayq_canvas_bootstrap", window.name.slice(handoffPrefix.length));
+            window.name = "";
+        }
+        const raw = window.sessionStorage.getItem("relayq_canvas_bootstrap");
+        return raw ? JSON.parse(raw) : null;
+    } catch {
+        return null;
+    }
+}
+
+export function useRelayQIntegration() {
+    const config = bootstrap();
+    const [balance, setBalance] = useState<number | null>(config?.user?.balance ?? null);
+
+    useEffect(() => {
+        if (!config?.api_key) return;
+        const refresh = async () => {
+            try {
+                const response = await fetch("/v1/usage", { headers: { Authorization: `Bearer ${config.api_key}` } });
+                if (response.status === 401 || response.status === 403) {
+                    window.sessionStorage.removeItem("relayq_canvas_bootstrap");
+                    window.location.assign(`${config.relayq_origin || ""}/login?redirect=/canvas`);
+                    return;
+                }
+                if (!response.ok) return;
+                const data = await response.json();
+                if (typeof data.balance === "number") setBalance(data.balance);
+            } catch {}
+        };
+        void refresh();
+        const interval = window.setInterval(refresh, 30000);
+        const onFocus = () => void refresh();
+        const onBalanceRefresh = () => void refresh();
+        window.addEventListener("focus", onFocus);
+        window.addEventListener("relayq:balance-refresh", onBalanceRefresh);
+        return () => {
+            window.clearInterval(interval);
+            window.removeEventListener("focus", onFocus);
+            window.removeEventListener("relayq:balance-refresh", onBalanceRefresh);
+        };
+    }, [config?.api_key]);
+
+    const exit = () => {
+        window.sessionStorage.removeItem("relayq_canvas_bootstrap");
+        window.location.assign(`${config?.relayq_origin || ""}${config?.dashboard_url || "/dashboard"}`);
+    };
+
+    return { managed: Boolean(config?.api_key), balance, usageUrl: config?.usage_url || "/usage", exit };
+}
diff --git a/web/src/lib/relayq-mimo-audio.ts b/web/src/lib/relayq-mimo-audio.ts
