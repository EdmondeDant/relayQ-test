+++ b/web/src/lib/relayq-mimo-audio.ts
@@ -0,0 +1,21 @@
+import type { ChannelModel, ModelCapability } from "@/stores/use-config-store";
+
+const MIMO_AUDIO_MODELS = new Set(["mimo-v2.5-tts", "mimo-v2.5-tts-voiceclone", "mimo-v2.5-tts-voicedesign", "mimo-v2-tts"]);
+
+const RELAYQ_MIMO_AUDIO_SCRIPT = `
+http.post("/chat/completions", {
+  model,
+  audio: model === "mimo-v2.5-tts-voicedesign"
+    ? { format: params.format || "wav", optimize_text_preview: true }
+    : { format: params.format || "wav", voice: model === "mimo-v2.5-tts-voiceclone" ? (params.reference_audio || params.referenceAudio || params.voice) : (params.voice && params.voice !== "alloy" ? params.voice : "mimo_default") },
+  messages: [
+    { role: "user", content: params.instructions || (model === "mimo-v2.5-tts-voicedesign" ? prompt : "请用自然讲述风格朗读。") },
+    { role: "assistant", content: params.text || prompt },
+  ],
+  stream: false,
+}).then(data => data?.choices?.[0]?.message?.audio?.data || data?.audio?.data || "")
+`.trim();
+
+export function withRelayQModelScript(model: { id: string; modality: ModelCapability }): ChannelModel {
+    return { name: model.id, capability: model.modality, ...(MIMO_AUDIO_MODELS.has(model.id) ? { script: RELAYQ_MIMO_AUDIO_SCRIPT } : {}) };
+}
